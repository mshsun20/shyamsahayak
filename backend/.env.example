# ============================================================================================================================================================
# Node Environment --------------------
# NODE_ENV=production
# NODE_ENV=quality
NODE_ENV=development



# ============================================================================================================================================================
# API Name --------------------
API_NAME_PRD=shyamsahayak-prd-api
API_NAME_QAS=shyamsahayak-qas-api
API_NAME_DEV=shyamsahayak-dev-api

# Network Configs
PORT_PRD=5000
PORT_QAS=5001
PORT_DEV=5002

# API Server auth
APP_API_USR=digitalapi
APP_API_PSS=Shyam@12345


# APP URLs
APP_URL_PRD=https://shyamsahayak.shyamgroup.com
APP_URL_QAS=https://shyamsahayak-qas.shyamgroup.com
APP_URL_DEV=http://localhost:3002

# API URL ---------------------
API_URL_PRD=https://shyamsahayak.shyamgroup.com/api
API_URL_QAS=https://shyamsahayak-qas.shyamgroup.com/api
API_URL_DEV=http://localhost:5002/api

# ============================================================================================================================================================

# DB Connections
ONLN_DBURL_PRD=
ONLN_DBURL_QAS=
ONLN_DBURL_DEV=
OFFLN_DBURL=mongodb://127.0.0.1:27017/

# Session Tokens
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_CHALLENGE_SECRET=
# Tokens & Cookies Expiry
ACCESS_EXP_PRD=5
REFRESH_EXP_PRD=7
CHALLENGE_EXP_PRD=7
ACCESS_EXP_QAS=5
REFRESH_EXP_QAS=7
CHALLENGE_EXP_QAS=5
ACCESS_EXP_DEV=120
REFRESH_EXP_DEV=1
CHALLENGE_EXP_DEV=1


# ========================================================================================================
# Claude Integration Configs
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=2048

# ========================================================================================================
# Server Project root
PROJECTS_ROOT=/var/www

# Upload Limits
UPLD_COUNT=5
UPLD_SIZE_MB=10

# ========================================================================================================
# Microsoft Graph OAuth2 Mail configs
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SERVICE_MAIL=branding.corporateaffairs@shyammetalics.com
# SERVICE_MAIL=donotreply.digital@shyamgroup.com

# ============================================================================================================================================================
